{
  "name": "@togo-framework/ui-markdown",
  "version": "0.1.0",
  "description": "togo UI kit — markdown renderer (GFM, syntax highlighting, mermaid-ready) + editor. Depends on @togo-framework/ui-core and @togo-framework/ui-data-table.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@togo-framework/ui-core": "^0.1.2",
    "@togo-framework/ui-data-table": "^0.1.0",
    "@tanstack/react-table": "^8.21.3",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "mermaid": "^11.15.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.462.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
